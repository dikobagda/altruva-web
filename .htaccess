# =============================================
# Redirect Rules for altruva.co.id
# =============================================

RewriteEngine On

# 1. Redirect www → non-www (301 Permanent)
RewriteCond %{HTTP_HOST} ^www\.altruva\.co\.id [NC]
RewriteRule ^(.*)$ https://altruva.co.id/$1 [R=301,L]

# 2. Force HTTPS (HTTP → HTTPS)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]